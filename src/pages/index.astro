---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { getAllPosts } from '@/lib/data-utils'
import { Button } from "@/components/ui/button"
import { cn } from '@/lib/utils'
import { Separator } from '@/components/ui/separator'
import { HoverExpand } from "@/components/unlumen-ui/hover-expand";

const blog = await getRecentPosts(SITE.featuredPostCount)

const allPosts = await getAllPosts()

const featuredIds = ['daah-corpus', 'daah-zanzibar']

const featuredPosts = allPosts.filter(post => featuredIds.includes(post.id))

const items = [
  {
    label: "Kyoto",
    sublabel: "Japan",
    description: "Ancient temples hidden among bamboo groves",
    image: "/images/kyoto.jpg",
  },
];

---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  
  <section>
    <div class="rounded-lg border">
      <div class="flex flex-col space-y-1.5 p-6">
        <!-- Log -->
        <h3 class="text-3xl leading-none font-medium flex items-center gap-x-1">
          <span>l</span>
          <lord-icon
            src="/animations/o-logo-stack.json"
            trigger="loop"
            stroke="bold"
            state="hover-pinch"
            class="w-[1.2em] h-[1.2em]"
            colors="primary:#ea580c,secondary:#000000" 
          >
          </lord-icon>
          <span>g</span>
        </h3>
        
        <p class="text-muted-foreground text-sm">
          /lɒɡ/ &bull; <span class="font-medium">noun</span>
          <p class="text-muted-foreground text-sm">
            a full written record of a journey, a period of time, or an event.
          </p>
        </p>
      </div>

      <!-- SEPARATOR -->
      <div class="w-full flex justify-center py-2">
        <div class="h-[1px] w-[65%] bg-border separatorGradient"></div>
      </div>
      
      <!-- PROJECT SECTION -->
      <div class="flex flex-col space-y-1.5 p-6">
        <h3 class="text-3xl leading-none font-medium flex items-center gap-x-1 text-gradient">
          <span>  
            <lord-icon
              src="/animations/project-stack.json"
              trigger="loop"
              stroke="bold"
              state="hover-pinch"
              class="w-[1.2em] h-[1.2em]"
              colors="primary:#000000,secondary:#ea580c" 
            >
            </lord-icon>
          </span>
          pro•ject
        </h3>
      <p class="text-muted-foreground text-sm">
        /ˈprɑː.dʒekt/ &bull; <span class="font-medium">noun</span>
      </p>
      <p class="text-muted-foreground text-sm">
        a piece of planned work or an activity that is finished over a period of time and intended to achieve a particular purpose 
      </p>
      
      <HoverExpand items={items} />;

      </div>
      

      <!-- SEPARATOR -->
      <div class="w-full flex justify-center py-2">
        <div class="h-[1px] w-[65%] bg-border separatorGradient"></div>
      </div>

      <!-- Class Navigations -->
      <div class="flex flex-col space-y-1.5 p-6">
        <div class="flex flex-wrap items-center gap-2 md:flex-row">
          <Link href="/tags/capstone" class= {cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}>
            <span class="transition-transform group-hover:-translate-x-1">&#9675;</span> Capstone
          </Link>
          <Link href="/tags/machine-lab" class= {cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}>
            <span class="transition-transform group-hover:-translate-x-1">&#9675;</span> Machine Lab
          </Link>
          <Link href="/tags/bodyarchive" class= {cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}>
            <span class="transition-transform group-hover:-translate-x-1">&#9675;</span> The Body Archive
          </Link>
          <Link href="/tags/digital-archive" class= {cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}>
            <span class="transition-transform group-hover:-translate-x-1">&#9675;</span> Digital Archive & Art Humanities
          </Link>
          <Link href="/tags/future-punk" class= {cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}>
            <span class="transition-transform group-hover:-translate-x-1">&#9675;</span> Future Punk
          </Link>
          <Link href="/tags/understanding-im" class= {cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}>
            <span class="transition-transform group-hover:-translate-x-1">&#9675;</span> Understanding IM
          </Link>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script src="https://cdn.lordicon.com/lordicon.js"></script>

<style>
  /* Custom nudge to make the cube sit perfectly on the text baseline */
  lord-icon {
    display: inline-block;
    vertical-align: -0.2em; /* This moves it down slightly to match the 'l' and 'g' */
  }
</style>


