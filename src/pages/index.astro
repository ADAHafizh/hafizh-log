---
import BentoCard from '@/components/BentoCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { Highlighter } from '@/components/ui/highlighter'
import { HoverExpand } from '@/components/unlumen-ui/hover-expand'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts, getRecentPosts } from '@/lib/data-utils'
import { cn } from '@/lib/utils'

const blog = await getRecentPosts(SITE.featuredPostCount)

const allPosts = await getAllPosts()

const featuredIds = ['daah-corpus', 'daah-zanzibar']

const featuredPosts = allPosts.filter((post) => featuredIds.includes(post.id))

const items = [
  {
    label: 'Senspace',
    sublabel: 'Capstone',
    description:
      'A generative interactive installation, blending physical & digital.',
    image: '/static/bgSenspace.png',
    href: '/projects/senspace',
  },
  {
    label: 'Team Magma',
    sublabel: 'VBP',
    description: 'Neon-lit virtual body rock concert in a hot realm.',
    image: '/static/bgTeamMagma.jpg',
    href: '/projects/team-magma',
  },
  {
    label: 'Conch(ious)',
    sublabel: 'Conch',
    description: 'Speculative future artifact from underwater UAE 2080.',
    image: '/static/bgConchious.png',
    href: '/projects/conch',
  },
]

const projects = [
  // ROW 1: 2 + 1 = 3 columns
  {
    title: 'Capstone',
    image: '/static/1200x630.png',
    href: '/tags/capstone',
    span: 'md:col-span-2',
  },
  {
    title: 'Machine Lab',
    image: '/static/1200x630.png',
    href: '/tags/machine-lab',
    span: 'md:col-span-1',
  },

  // ROW 2: 1 + 2 = 3 columns
  {
    title: 'Future Punk',
    image: '/static/1200x630.png',
    href: '/tags/future-punk',
    span: 'md:col-span-1',
  },
  {
    title: 'Digital Archive & Art Humanities',
    image: '/static/1200x630.png',
    href: '/tags/digital-archive',
    span: 'md:col-span-2',
  },
]
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />

  <section>
    <div class="rounded-lg border">
      <div class="flex flex-col space-y-1.5 p-6">
        <!-- Log -->
        <h3 class="flex items-center gap-x-1 text-3xl leading-none font-medium">
          <span>l</span>
          <lord-icon
            src="/animations/o-logo-stack.json"
            trigger="loop"
            stroke="bold"
            state="hover-pinch"
            class="h-[1.2em] w-[1.2em]"
            colors="primary:#ea580c,secondary:#000000"
          >
          </lord-icon>
          <span>g</span>
        </h3>

        <p class="text-muted-foreground text-sm">
          /lɒɡ/ &bull; <span class="font-medium">noun</span>
          <p class="text-muted-foreground text-sm">
            a full written record of a journey, a period of time, or an event.
          </p>
        </p>
      </div>

      <!-- SEPARATOR -->
      <div class="flex w-full justify-center py-2">
        <div class="bg-border separatorGradient h-[1px] w-[65%]"></div>
      </div>

      <!-- PROJECT SECTION -->
      <div class="flex flex-col space-y-1.5 p-6">
        <h3
          class="text-gradient flex items-center gap-x-1 text-3xl leading-none font-medium"
        >
          <span>
            <lord-icon
              src="/animations/project-stack.json"
              trigger="loop"
              stroke="bold"
              state="hover-pinch"
              class="h-[1.2em] w-[1.2em]"
              colors="primary:#000000,secondary:#ea580c"
            >
            </lord-icon>
          </span>
          pro&bull;ject
        </h3>
        <p class="text-muted-foreground text-sm">
          /ˈprɑː.dʒekt/ &bull; <span class="font-medium">noun</span>
        </p>
        <p class="text-muted-foreground text-sm">
          a piece of planned work or an activity that is finished over a period
          of time and intended to achieve a particular purpose
        </p>

        <!-- #Magic UI Text -->
        <!-- <p>
          The{' '}
          <Highlighter client:load action="underline" color="#FF9800">
            Magic UI Highlighter
          </Highlighter>{' '}
          makes important{' '}
          <Highlighter client:load action="highlight" color="#87CEFA">
            text stand out
          </Highlighter>{' '}
          effortlessly.
        </p>

        <div class="pt-4">
          <HoverExpand client:load items={items} />
        </div>
      </div> -->

        <!-- SEPARATOR -->
        <div class="flex w-full items-center justify-center py-8">
          <div class="bg-border separatorGradient h-[1px] flex-grow"></div>

          <span
            class="text-muted-foreground px-4 text-xs font-medium tracking-widest whitespace-nowrap uppercase"
          >
            Looking for more?
          </span>

          <div class="bg-border separatorGradient h-[1px] flex-grow"></div>
        </div>

        <section class="mx-auto max-w-6xl p-4">
          <div class="grid auto-rows-[280px] grid-cols-1 gap-4 md:grid-cols-3">
            {projects.map((project) => <BentoCard {...project} />)}
          </div>
        </section>

        <!-- Class Navigations -->
        <div class="flex flex-col space-y-1.5 p-6">
          <div class="flex flex-wrap items-center gap-2 md:flex-row">
            <Link
              href="/tags/capstone"
              class={cn(
                buttonVariants({ variant: 'outline' }),
                'flex gap-x-1.5 group',
              )}
            >
              <span class="transition-transform group-hover:-translate-x-1"
                >&#9675;</span
              > Capstone
            </Link>
            <Link
              href="/tags/machine-lab"
              class={cn(
                buttonVariants({ variant: 'outline' }),
                'flex gap-x-1.5 group',
              )}
            >
              <span class="transition-transform group-hover:-translate-x-1"
                >&#9675;</span
              > Machine Lab
            </Link>
            <Link
              href="/tags/bodyarchive"
              class={cn(
                buttonVariants({ variant: 'outline' }),
                'flex gap-x-1.5 group',
              )}
            >
              <span class="transition-transform group-hover:-translate-x-1"
                >&#9675;</span
              > The Body Archive
            </Link>
            <Link
              href="/tags/digital-archive"
              class={cn(
                buttonVariants({ variant: 'outline' }),
                'flex gap-x-1.5 group',
              )}
            >
              <span class="transition-transform group-hover:-translate-x-1"
                >&#9675;</span
              > Digital Archive & Art Humanities
            </Link>
            <Link
              href="/tags/future-punk"
              class={cn(
                buttonVariants({ variant: 'outline' }),
                'flex gap-x-1.5 group',
              )}
            >
              <span class="transition-transform group-hover:-translate-x-1"
                >&#9675;</span
              > Future Punk
            </Link>
            <Link
              href="/tags/understanding-im"
              class={cn(
                buttonVariants({ variant: 'outline' }),
                'flex gap-x-1.5 group',
              )}
            >
              <span class="transition-transform group-hover:-translate-x-1"
                >&#9675;</span
              > Understanding IM
            </Link>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="https://cdn.lordicon.com/lordicon.js"></script>

  <style>
    /* Custom nudge to make the cube sit perfectly on the text baseline */
    lord-icon {
      display: inline-block;
      vertical-align: -0.2em; /* This moves it down slightly to match the 'l' and 'g' */
    }
  </style>
</Layout>
