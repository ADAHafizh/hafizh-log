---

const { title, image, href, span } = Astro.props;

---

<a
  href={href}
  class={`group relative overflow-hidden rounded-xl border border-white/10 bg-zinc-950 min-h-[280px] transition-all hover:border-orange-500/40 ${span}`}
>
  <img 
    src={image} 
    alt={title}
    class="absolute inset-0 h-full w-full object-cover opacity-40 transition-transform duration-700 group-hover:scale-105"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
  <div class="absolute bottom-6 left-6">
    <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-orange-500/80">Project</span>
    <h3 class="text-xl font-medium text-white/90">{title}</h3>
  </div>
</a>